# =============================================================================
# AI Scam Shield — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file to version control.
# This file must contain ONLY placeholder values, never real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Google Gemini AI (Text analysis + optional audio transcription)
# Get your key at: https://aistudio.google.com/app/apikey
# Without this key, the app runs on the built-in deterministic heuristic engine.
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# The Gemini model used for text/message/URL/QR analysis.
# Model history (as of October 2026):
#   gemini-1.5-flash  → SHUT DOWN (early 2026)
#   gemini-2.0-flash  → SHUT DOWN (June 1, 2026)
#   gemini-2.5-flash  → Existing projects only (restricted to prior users)
#   gemini-3.8-flash  → Current stable recommended for all new projects ✅
# Defaults to gemini-3.8-flash if unset.
GEMINI_TEXT_MODEL="gemini-3.8-flash"

# The Gemini model used for audio transcription.
# gemini-3.8-flash supports audio/multimodal input natively.
# For dedicated transcription: gemini-3.5-transcribe (see ai.google.dev/gemini-api/docs/models)
# Defaults to gemini-3.8-flash if unset.
GEMINI_AUDIO_MODEL="gemini-3.8-flash"

# -----------------------------------------------------------------------------
# OPTIONAL — Google Safe Browsing API v4 (URL reputation)
# Get your key at: https://developers.google.com/safe-browsing/v4/get-started
# Free tier: up to 10,000 URL checks per day.
# Without this key, URL analysis falls back to local heuristics only.
# -----------------------------------------------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY="your_google_safe_browsing_key_here"

# -----------------------------------------------------------------------------
# OPTIONAL — VirusTotal API v3 (Second URL reputation source)
# Get your key at: https://www.virustotal.com/gui/sign-in (free tier available)
# Free tier: 4 lookups/minute, 500/day.
# Without this key, VirusTotal checks are silently skipped.
# NOTE: VirusTotal ToS prohibits scanning of URLs containing personal/auth tokens.
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY="your_virustotal_api_key_here"

# -----------------------------------------------------------------------------
# OPTIONAL — MongoDB URI (Persistent community reports storage)
# Without this, community reports are stored in process memory (reset on restart).
# Format: mongodb://user:pass@host:port/dbname or mongodb+srv://...
# -----------------------------------------------------------------------------
MONGODB_URI="your_mongodb_connection_uri_here"

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=3000

# The public URL of this application (used for self-referential links).
APP_URL="http://localhost:3000"
